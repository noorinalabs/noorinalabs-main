// markdownlint-cli2 config for noorinalabs-main committed docs (#326).
//
// These are dense operational charter/process docs: long lines, inline HTML
// comments (promotion-target markers), deeply nested lists, and repeated
// section headings across files are INTENTIONAL, not defects. The goal of the
// docs-lint job is to catch genuinely broken markdown (unclosed code fences,
// malformed link syntax, hard tabs, trailing-space line breaks that silently
// drop content) — NOT to reflow the existing corpus to a style guide.
//
// Accordingly the noisy stylistic rules the corpus deliberately violates are
// disabled here; the structural rules that catch real rendering breakage stay
// on. Tightening individual rules is a follow-up once the corpus is clean.
{
  "config": {
    "default": true,

    // --- intentionally-violated stylistic rules (disabled) ---
    // Each was empirically verified to fire pervasively across the existing
    // corpus (counts from the first CI run on this branch) and reflects a
    // deliberate house style, not a defect.
    "MD013": false, // line-length — dense tables + prose run long by design
    "MD033": false, // inline HTML — promotion-target <!-- --> markers + <br> in tables
    "MD024": false, // duplicate headings — same section name recurs across docs/provenance blocks
    "MD041": false, // first-line-heading — some docs open with frontmatter or a note blockquote
    "MD036": false, // emphasis-as-heading — bold lead-ins ("**Why:**") are a house idiom
    "MD034": false, // bare URLs — issue/PR refs are pasted bare throughout
    "MD029": false, // ordered-list prefix — manual numbering restarts in escalation lists
    "MD040": false, // fenced-code language — many illustrative blocks are intentionally bare
    "MD046": false, // code-block style — mixed fenced/indented across older docs
    "MD007": false, // unordered-list indentation — nested briefs use varied indent
    "MD028": false, // blank line inside blockquote — multi-para notes use them
    "MD025": false, // multiple top-level headings — some compiled docs concatenate sections
    "MD060": false, // table-column-style — compact table pipes (1582 hits) are house style
    "MD032": false, // blanks-around-lists — tight list/heading packing is pervasive (428 hits)
    "MD022": false, // blanks-around-headings — same tight packing (369 hits)
    "MD031": false, // blanks-around-fences — tight fence packing (51 hits)
    "MD004": false, // ul-style — mixed -/* bullets across older docs (45 hits)
    "MD058": false, // blanks-around-tables — tight table packing (22 hits)
    "MD012": false, // no-multiple-blanks — deliberate spacing in append-only records (21 hits)
    "MD049": false, // emphasis-style — mixed _/* emphasis (8 hits)
    "MD038": false, // spaces-in-code — intentional `TechDebt: ` / `§ Section ` prose spans (15 hits)
    "MD051": false, // link-fragments — false-positives on headings carrying trailing <!-- --> comments (13 files use that idiom); relative-file link breakage is covered by lychee instead

    // --- structural rules kept ON (catch real breakage) ---
    // MD009 trailing-spaces, MD047 single-trailing-newline, MD010 hard-tabs,
    // MD042 empty-link, MD039 spaces-in-link-text, MD011 reversed-link-syntax,
    // MD037 spaces-in-emphasis, and the rest of `default: true` remain enforced.
    // The 3 genuine MD009/MD047 violations the first run surfaced were FIXED in
    // this same change rather than suppressed, so these rules stay green going
    // forward.
    "MD010": { "code_blocks": false } // allow hard tabs inside code blocks only
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "noorinalabs-isnad-graph/**",
    "noorinalabs-user-service/**",
    "noorinalabs-deploy/**",
    "noorinalabs-design-system/**",
    "noorinalabs-data-acquisition/**",
    "noorinalabs-isnad-ingest-platform/**",
    "noorinalabs-landing-page/**",
    ".claude/worktrees/**",
    "node_modules/**"
  ]
}
